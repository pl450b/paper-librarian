# Copy to librarian/.env and fill in. Keep it private:  chmod 600 librarian/.env
# Every setting is optional.

# OpenAlex (recommended before a large backfill): free key from
# https://openalex.org/settings/api . Without it, lookups share one small
# daily budget with everyone on your network's IP address.
OPENALEX_API_KEY=

# Models, as `claude` CLI aliases (haiku, sonnet, opus) or full model ids.
# Triage reads every paper's abstract/intro; the deep model reads relevant
# papers in full and answers library-wide questions.
# LIBRARIAN_TRIAGE_MODEL=haiku
# LIBRARIAN_DEEP_MODEL=sonnet

# Ports, if 8765/8766 are taken.
# LIBRARIAN_PORT=8766
# LIBRARIAN_APP_URL=http://127.0.0.1:8765
